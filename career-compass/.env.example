# Copy this to .env for local reference only — never commit real secrets.
# In production (Render, Railway, etc.), set these in the host's
# environment variable settings UI instead of a file.

# --- Database (Supabase or any Postgres with pgvector enabled) ---
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_SSL_PARAMS=?sslmode=require

# --- AI provider (Groq) ---
GROQ_API_KEY=your-groq-api-key

# --- JWT ---
JWT_SECRET=a-long-random-production-secret-at-least-32-characters

# --- Email (Brevo or any SMTP provider) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@yourdomain.com

# --- Server ---
# PORT is usually injected automatically by the host (Render, Railway, etc.)
# — only set manually for local testing if needed.
PORT=8080
JINA_API_KEY=
JINA_DIMENSIONS=384
# --- Email (Brevo HTTP API) ---
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=noreply@yourdomain.com